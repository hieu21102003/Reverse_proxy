HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
VSQI_BASE_URL=https://tieuchuan.vsqi.gov.vn
VSQI_SEARCH_PATH=/tim-kiem
VSQI_DETAIL_PATH=/tieuchuan/view
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=1
VSQI_TLS_SUPPLEMENTAL_CA=true
HTTP_USER_AGENT=VSQI-Proxy-API/1.0 (+https://your-service.example/contact)
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=false
CORS_ORIGIN=
# Set false only if you have permission and a verified parser for the current site.
VSQI_ENABLED=true
# tracuu.tcvn.vn JSON API (Vietnamese + international standards). HTTP-only:
# the host currently resets HTTPS connections, so keep the http: default.
# The client only ever contacts this exact host.
TCVN_BASE_URL=http://tracuu.tcvn.vn/sdomain/front-api
TCVN_ENABLED=true
# Records requested per TCVN search call (per title field / per organisation).
TCVN_SEARCH_LIMIT=20
# Max organisations fanned out to for an international title query.
TCVN_QT_MAX_ORGS=11
# How long the fetched international organisation list is cached (seconds).
TCVN_ORG_LIST_TTL_SECONDS=3600
# Elib document service (separate Fastify + PostgreSQL backend).
# Reverse_proxy proxies /api/elib/* to {ELIB_BASE_URL}/api/* with streaming.
# Production: elib binds 127.0.0.1:3200 behind Reverse_proxy.
# Docker caveat: inside a container 127.0.0.1 is the container itself. When
# Reverse_proxy runs via docker-compose.yml it joins the shared network
# elib-net, so use http://elib-service:3200 (elib's container_name) — see
# .env.server.example. Keep 127.0.0.1:3200 for local/bare-Node runs.
ELIB_BASE_URL=http://127.0.0.1:3200
# Set false to disable the elib proxy (/api/elib/* returns 503).
ELIB_ENABLED=true
# Generous proxy timeout for elib uploads/downloads (ms).
ELIB_TIMEOUT_MS=300000
