HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
VSQI_BASE_URL=https://tieuchuan.vsqi.gov.vn
VSQI_SEARCH_PATH=/tim-kiem
VSQI_DETAIL_PATH=/tieuchuan/view
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=1
HTTP_USER_AGENT=VSQI-Proxy-API/1.0 (+https://your-service.example/contact)
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=false
CORS_ORIGIN=
# Set false only if you have permission and a verified parser for the current site.
VSQI_ENABLED=true
# Optional temporary diagnostics endpoint; use a random token of at least 32 characters.
# Remove from the deployment environment after collecting diagnostics.
# VSQI_DIAGNOSTICS_TOKEN=
