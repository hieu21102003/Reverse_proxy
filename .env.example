HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
VSQI_BASE_URL=https://tieuchuan.vsqi.gov.vn
VSQI_SEARCH_PATH=/tim-kiem
VSQI_DETAIL_PATH=/tieuchuan/view
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=1
VSQI_TLS_SUPPLEMENTAL_CA=true
HTTP_USER_AGENT=VSQI-Proxy-API/1.0 (+https://your-service.example/contact)
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=false
CORS_ORIGIN=
# Set false only if you have permission and a verified parser for the current site.
VSQI_ENABLED=true
# tracuu.tcvn.vn JSON API (Vietnamese + international standards). HTTP-only:
# the host currently resets HTTPS connections, so keep the http: default.
# The client only ever contacts this exact host.
TCVN_BASE_URL=http://tracuu.tcvn.vn/sdomain/front-api
TCVN_ENABLED=true
# Records requested per TCVN search call (per title field / per organisation).
TCVN_SEARCH_LIMIT=20
# Max organisations fanned out to for an international title query.
TCVN_QT_MAX_ORGS=11
# How long the fetched international organisation list is cached (seconds).
TCVN_ORG_LIST_TTL_SECONDS=3600
