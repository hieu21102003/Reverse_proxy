# Reverse_proxy — biến môi trường production trên server
# Copy thành .env trong thư mục repo và sửa các giá trị cần thiết.
# (Dựa trên .env.example của repo tại master 0ab9b21.)

# Docker: 0.0.0.0 | Node trực tiếp sau nginx: 127.0.0.1
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

# --- Nguồn VSQI (bắt buộc HTTPS) ---
VSQI_BASE_URL=https://tieuchuan.vsqi.gov.vn
VSQI_SEARCH_PATH=/tim-kiem
VSQI_DETAIL_PATH=/tieuchuan/view
VSQI_TLS_SUPPLEMENTAL_CA=true
VSQI_ENABLED=true

# --- Nguồn TCVN (chỉ HTTP, host reset HTTPS — giữ nguyên http:) ---
TCVN_BASE_URL=http://tracuu.tcvn.vn/sdomain/front-api
TCVN_ENABLED=true
TCVN_SEARCH_LIMIT=20
TCVN_QT_MAX_ORGS=11
TCVN_ORG_LIST_TTL_SECONDS=3600

# --- HTTP client / cache / rate limit ---
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=1
HTTP_USER_AGENT=VSQI-Proxy-API/1.0 (+https://your-domain.example/contact)
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute

# --- Sau nginx: bật TRUST_PROXY, CORS để trống nếu cùng domain ---
TRUST_PROXY=true
CORS_ORIGIN=

# --- Elib (dịch vụ tài liệu riêng, cổng 3200, chỉ nội bộ) ---
# Reverse_proxy chuyển tiếp /api/elib/* sang elib. Elib chạy riêng với
# PostgreSQL + STORAGE_ROOT của nó; xem docs/deploy-server.md.
# Nếu Reverse_proxy chạy Docker: dùng mạng dùng chung elib-net (compose tạo
# sẵn) — ELIB_BASE_URL=http://elib-service:3200 (elib-service là
# container_name của elib). Nếu chạy Node trực tiếp trên cùng máy với elib:
# dùng http://127.0.0.1:3200.
ELIB_BASE_URL=http://elib-service:3200
ELIB_ENABLED=true
ELIB_TIMEOUT_MS=300000
